{
  "name": "yutu-chinese",
  "version": "0.1.0",
  "description": "Personal, local-first Chinese character writing trainer",
  "license": "GPL-3.0-only",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-char-data.js && node scripts/copy-audio.js",
    "dev": "vite",
    "prebuild": "node scripts/copy-char-data.js && node scripts/copy-audio.js",
    "build": "vite build",
    "postbuild": "node scripts/build-offline.js && node scripts/sbom.js",
    "preview": "vite preview",
    "test": "node --test",
    "pretest:browser": "node scripts/copy-char-data.js && node scripts/copy-audio.js",
    "test:browser": "node tests/browser/run.js",
    "sync-server": "ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173 DATA_DIR=local/sync-data node server/server.js"
  },
  "dependencies": {
    "fzstd": "^0.1.1",
    "hanzi-writer": "^3.7.3",
    "hanzi-writer-data": "^2.0.1",
    "jsqr": "^1.4.0",
    "qrcode-generator": "^2.0.4",
    "sql.js": "^1.15.2",
    "ts-fsrs": "^5.4.2"
  },
  "devDependencies": {
    "vite": "^8.3.5"
  }
}
