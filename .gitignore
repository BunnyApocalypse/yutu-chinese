# Downloaded dependencies (recreated by `npm install`)
node_modules/

# Build output (recreated by `npm run build`)
dist/
dist-move/

# Stroke data copied from node_modules by scripts/copy-char-data.js
public/char-data/
public/char-data-tw/

# Recordings copied from data/audio-cmn by scripts/copy-audio.js
public/audio/

# Personal data exports (e.g. from Skritter) never belong in the repo
exports/

# Large files fetched for development only, never shipped (see local/README.md)
local/*
!local/README.md

# The sync server's settings that stay off GitHub (deploy/README.md)
deploy/host_vars/*/private.yml
