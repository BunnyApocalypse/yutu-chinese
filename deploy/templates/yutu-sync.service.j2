# The sync server as a service: systemd starts it with the machine and again
# if it stops. Written by Ansible (deploy/setup.yml).
[Unit]
Description=Sync server of Yutu Chinese
After=network-online.target
Wants=network-online.target

[Service]
User=yutu-sync
Group=yutu-sync
EnvironmentFile=/etc/yutu-sync.env
ExecStart=/usr/bin/node {{ sync_code_dir }}/server.js
Restart=on-failure
RestartSec=5

# What the program may touch: only its own files. systemd keeps it from the
# rest of the machine even if it were made to misbehave.
StateDirectory=yutu-sync
StateDirectoryMode=0700
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
