# The sync server's settings (server/README.md), from deploy/group_vars and
# the inventory. Written by Ansible: changes here are undone by the next run.
PORT={{ sync_port }}
DATA_DIR={{ sync_data_dir }}
ALLOWED_ORIGINS={{ sync_allowed_origins | join(',') }}
MAX_FILE_MB={{ sync_max_file_mb }}
MAX_ACCOUNT_MB={{ sync_max_account_mb }}
MAX_TOTAL_MB={{ sync_max_total_mb }}
NEW_ACCOUNTS_UNTIL_PERCENT={{ sync_new_accounts_until_percent }}
NEW_ACCOUNTS_PER_DAY={{ sync_new_accounts_per_day }}
NEW_ACCOUNTS_PER_ADDRESS_PER_DAY={{ sync_new_accounts_per_address_per_day }}
REQUESTS_PER_ACCOUNT_PER_MINUTE={{ sync_requests_per_account_per_minute }}
REQUESTS_PER_ADDRESS_PER_MINUTE={{ sync_requests_per_address_per_minute }}
UPLOADS_AT_ONCE_PER_ACCOUNT={{ sync_uploads_at_once_per_account }}
UPLOADS_AT_ONCE_PER_ADDRESS={{ sync_uploads_at_once_per_address }}
UPLOADS_AT_ONCE={{ sync_uploads_at_once }}
DOWNLOAD_MB_PER_ACCOUNT_PER_HOUR={{ sync_download_mb_per_account_per_hour }}
GENEROUS_ADDRESSES={{ sync_generous_addresses | join(',') }}
EXPIRE_DAYS={{ sync_expire_days }}
# Behind Caddy, which says who is asking.
TRUST_PROXY=1
SYNC_PAUSED={{ '1' if sync_paused | bool else '0' }}
