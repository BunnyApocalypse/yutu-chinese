#!/bin/sh
# Every few minutes (yutu-healthcheck.timer): tells Healthchecks whether the
# sync server answers through HTTPS and the disk has room. Healthchecks
# emails the owner when a ping says "fail", or when pings stop coming (the
# whole machine down). Written by Ansible (deploy/setup.yml).
#
# Caddy is asked on this machine (--resolve), with the real name and
# certificate: a moment when the name can't be looked up isn't the server
# down (2026-11-07: one false alarm so, just after the DNS records were
# made). Asked three times before saying so.
ok=1
curl -fsS --max-time 10 --retry 2 --retry-all-errors \
  --resolve {{ sync_domain }}:443:127.0.0.1 \
  https://{{ sync_domain }}/v1/health >/dev/null || ok=0
used=$(df --output=pcent {{ sync_data_dir }} | tail -1 | tr -dc 0-9)
[ "$used" -lt 90 ] || ok=0
if [ "$ok" = 1 ]; then
  curl -fsS --max-time 10 --retry 3 {{ healthcheck_url }} >/dev/null
else
  curl -fsS --max-time 10 --retry 3 {{ healthcheck_url }}/fail >/dev/null
fi
{% if healthcheck_limits_url | length > 0 %}

# The limits, on a check of their own: the sync server's LIMIT lines since
# the last look (journalctl keeps its place in the cursor file), and how
# full the server is. Sent without the addresses ("from …"): those stay in
# the server's own log, kept at most 14 days, as the privacy page says.
limits=$(journalctl -u yutu-sync -o cat --no-pager --grep '^LIMIT ' \
  --cursor-file=/var/lib/yutu-healthcheck/cursor | sed 's/ from .*//')
holds=$(du -sb {{ sync_data_dir }} | cut -f1)
percent=$((holds * 100 / ({{ sync_max_total_mb }} * 1024 * 1024)))
if [ "$percent" -ge {{ sync_warn_percent }} ]; then
  limits="$limits
ROOM the server holds ${percent}% of the most it may (new accounts stop at {{ sync_new_accounts_until_percent }}%)"
fi
if [ -n "$limits" ]; then
  printf '%s\n' "$limits" | head -c 10000 | \
    curl -fsS --max-time 10 --retry 3 --data-binary @- {{ healthcheck_limits_url }}/fail >/dev/null
else
  curl -fsS --max-time 10 --retry 3 {{ healthcheck_limits_url }} >/dev/null
fi
{% endif %}
# Failed in the journal too.
[ "$ok" = 1 ]
